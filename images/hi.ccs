
.mega-menu{
    position: absolute;
    width: 100%;
    height: 400px;
    background-color: whitesmoke;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    display: none;
    top: 70px;
    left: 0;
    justify-content: space-evenly;
    z-index: 1000;

}
.menu-item {
    width: fit-content;
    height: 70px;
    display: flex;
    align-items: center;
}
.menu-item>a:hover{
    text-decoration: underline;
    text-decoration-color: orange;
    text-decoration-thickness:4px;
    text-underline-offset: 25px;
}
.menu-item:hover > .mega-menu{
    display: flex;

}
 .items{
        display: flex;
        flex-direction: column;
        overflow: auto; 
        scrollbar-width: none;

}
.m1 {
    line-height: 40px;
    height: 400px;
    width: 23%;
    background-color: white;
    padding: 10px;

}
.m2{
   line-height: 40px;
    height: 400px;
    width: 25%;
    background-color:#FFFDF5;
    padding: 10px;
  
}

         /*  ===============header2========== */
.header2{
    width: 100%;
    height: 100px;
    display: flex;
    gap: 30px;
    justify-content:flex-start;
    align-items: center;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    position:relative;
    top: 0px;
    /* z-index: 998; */
}
.header2 a{
    text-decoration: none;
    color: black;
    font-size: 1.3rem;
    flex-shrink: 0;
    padding-right: 30px;
     
}
.gender-toggle {
    position: relative;
    left: auto;
    width: 250px;
    height: 50px;
    display: flex;
    background: #f5f6f7;
    border-radius: 50px;
    margin-left: 40px;
    flex-shrink: 0;
    /* z-index: 1; */
    box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.12);
    
}

.gender-toggle input {
    display: none;
}

.gender-toggle label {
    position: relative;
    z-index: 2;

    width: 50%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 20px;
    color: #263d63;

    cursor: pointer;
}

/* Yellow pill */
.gender-toggle::before {
    content: "";
    position: absolute;

    width: 50%;
    height: 100%;

    left: 0;

    background: #ffd32a;
    border-radius: 50px;

    transition: 0.3s ease;
}

#women:checked ~ label {
    /* nothing */
}

.gender-toggle:has(#women:checked)::before {
    left: 50%;
}
 .fixed{
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    background-color: white;
} 

/* ================= */
/* HERO SECTION */
/* =============== */

/* img section */
.heroslide-men{
    width: 100%;
    height: 700px;
    display: flex;
    gap: 20px;
    overflow:hidden;
        margin-top: 0;
}
.slideimg-men{
    height:100% ;
    width: 100%;
    display: flex;
    margin-top: 200px;
    gap: 15px;
    animation: men-slid 21s infinite;
}
.slideimg-men img {
    width: 500px;
    height: 100%;
    object-fit: cover;
    flex-shrink: 0;
}

                  
@keyframes men-slid {

    0%, 15% {
        transform: translateX(0);
    }

    20%, 35% {
        transform: translateX(-515px);
    }

    40%, 55% {
        transform: translateX(-1030px);
    }

    60%, 75% {
        transform: translateX(-1545px);
    }

    80%, 95% {
        transform: translateX(-2060px);
    }

    100% {
        transform: translateX(0);
    }
}

/* slide men */
.slide-men1{
    width: 100%;
    height: 150px;
    display: flex;
    margin-top: 30px;
    animation: men-banner 30s ease infinite;
}
.slide-men1-container{
    width: 100%;
    height: 150px;
    overflow: hidden;
}
.slide-men1 img{
    width: 100%;
    height: 150px;
    object-fit: cover;
    flex-shrink: 0;

}

@keyframes men-banner{

    0%, 15%{
        transform: translateX(0);
    }

    20%, 35%{
        transform: translateX(-100%);
    }

    40%, 55%{
        transform: translateX(-200%);
    }

    60%, 75%{
        transform: translateX(-300%);
    }

    80%, 95%{
        transform: translateX(-400%);
    }

    100%{
        transform: translateX(0);
    }
}
.slide-men2{
    height: 250px;
    width: 100%;
}
.slide-men2 img{
    width: 100%;
    height: 300px;
    object-fit: cover;
    flex-shrink: 0;
}
.sellers-card{
    width: 400%;
    height: 600px;
    display: flex;
    gap: 10px;
    justify-content: center;
        transition:transform 0.8s ease-in-out;

}
.sellers-card>p{
     width: 100%;
    font-size: 1.5rem;
    padding-top: 20px;
    text-align: center;
}
.sellers{
    height:500px;
    width: calc(5% - 10px);
    background-color:white;
    margin-top:60px;
    position:relative;
    flex-shrink:0;
}
.sellers img{
    height:400px ;
    width: 100%;
    border-radius: 10px;
    
   
   
}
.sellers p{
    line-height: 1.7;
    padding-left: 20px;
    padding-top: 10px;
    font-size: 18px;
}
.seller-btn{
    position: absolute;
    top: 2%;
    right: 56%;
    z-index: 10;
    padding: 6px;
    border-radius: 5px;
}
.seller-btn2{
    position: absolute;
    right: 70%;
    top: 70%;
    padding: 5px;
   width: 25%;
   border-radius: 7px;
   font-weight: bold;
   font-size: 1rem;
   
}
input[name="seller-page"]{
    display:none;
}

.seller-slider{
    width:100%;
    height: 600px;
    overflow:hidden;
}
#page1:checked ~ .seller-slider .sellers-card{
    transform:translateX(0);
}

#page2:checked ~ .seller-slider .sellers-card{
    transform:translateX(-25%);
}

#page3:checked ~ .seller-slider .sellers-card{
    transform:translateX(-50%);
}

#page4:checked ~ .seller-slider .sellers-card{
    transform:translateX(-75%);
}
.next-btn,
.prev-btn{
    position:absolute;
    top:50%;
    transform:translateY(-50%);

    width:50px;
    height:50px;

    border:0;
    border-radius:50%;
    background:white;

    display:flex;
    align-items:center;
    justify-content:center;

    cursor:pointer;
    font-size:22px;
    z-index:10;
}

.next-btn{
    right:10px;
}

.prev-btn{
    left:10px;
}

/* ========================================SLIDE NXT BANNER SECTION ==========================*/

.banner-section{
    height: 500px;
    width: 100%;
    
}
.banner-section p{
    width: 100%;
    text-align: center;
    padding-top: 10px;
    font-size: 1.5rem;
}
.banner-section2{
    height: 450px;
    width: 100%;
    display: flex;
    margin-top: 20px;
    animation: banner 30s ease infinite;

}
.banner-section2 img{
    width: 100%;
    height: 450px;
    object-fit: cover;
    flex-shrink: 0;

}

@keyframes banner{

    0%, 15%{
        transform: translateX(0);
    }

    20%, 35%{
        transform: translateX(-100%);
    }

    40%, 55%{
        transform: translateX(-200%);
    }

    60%, 75%{
        transform: translateX(-300%);
    }

    80%, 95%{
        transform: translateX(-400%);
    }

    100%{
        transform: translateX(0);
    }
}

/* ==================== TRENDING CATEGORIES ==================== */

.cloths{
    width: 100%;
    margin-top: 30px;
}

.cloths-title{
    width: 100%;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.cloths-title p{
    font-size: 24px;
    letter-spacing: 2px;
    color: black;
}


/* IMAGE GRID */

.cloths-img{
    width: 100%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
}


/* EACH IMAGE CARD */

.im1{
    height: 425px;
    position: relative;
    overflow: hidden;
    background-color: #eee;
}


/* IMAGE */

.im1 img{
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}


/* DARK GRADIENT */

.im1::after{
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;

    width: 100%;
    height: 45%;

    background: linear-gradient(
        transparent,
        rgba(0,0,0,0.65)
    );
}


/* CATEGORY TEXT */

.im1 p{
    position: absolute;

    left: 15px;
    bottom: 20px;

    margin: 0;

    color: white;
    font-size: 23px;
    font-weight: 600;

    z-index: 2;
}


/* VIEW ALL */

.view-all{
    display: flex;
    align-items: center;
    justify-content: center;
        text-decoration: none;
    background: #f5f5f5;
}

.view-all p{
    color: black;
    font-size: 25px;
    font-weight: 500;
}


.savings-section{
    width: 100%;
    padding-top: 35px;
}


/* HEADING */

.savings-section h2{
    text-align: center;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 4px;
    margin-bottom: 20px;
}


/* ============================= */
/* CARD CONTAINER */
/* ============================= */

.savings-container{
    width: 100%;
    display: grid;

    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
}


/* ============================= */
/* CARD */
/* ============================= */

.saving-card{
    width: 100%;
    height: 270px;

    background-color: #FFE86A;

    border-radius: 8px;

    overflow: hidden;

    display: flex;
    flex-direction: column;
}


/* IMAGE */

.saving-card img{
    width: 100%;
    height: 225px;

    object-fit: cover;

    display: block;
}


/* ============================= */
/* TEXT AREA */
/* ============================= */

.saving-text{
    height: 45px;

    background-color: #FFE86A;

    display: flex;
    flex-direction: column;
    justify-content: center;
}


/* SMALL BLACK LABEL */

.saving-text span{
    position: absolute;

    margin-top: -55px;
    margin-left: 5px;

    background-color: black;
    color: white;

    padding: 3px 6px;

    font-size: 15px;
    font-weight: bold;

    line-height: 16px;
}


/* OFFER TEXT */

.saving-text h3{
    text-align: center;

    font-size: 20px;
    font-weight: 800;

    color: black;
}


/* ============================= */
/* SECOND ROW - CENTER */
/* ============================= */

.saving-card:nth-child(7){
    grid-column: 3;
}

.saving-card:nth-child(8){
    grid-column: 4;
}


/* ================= OVERSIZED SECTION ================= */

.oversized-section{
    width: 100%;
    margin-top: 35px;
}


/* ================= HEADING ================= */

.oversized-heading{
    width: 100%;
    text-align: center;
    margin-bottom: 30px;
}

.oversized-heading h1{
    font-size: 48px;
    font-weight: 700;
    margin-bottom: 5px;
}

.oversized-heading p{
    font-size: 30px;
    font-weight: 400;
    position: relative;
    display: inline-block;
}

.oversized-heading p::after{
    content: "";
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 170px;
    height: 4px;
    background-color: #fbc400;
    border-radius: 50%;
}


/* ================= CARDS ================= */

.oversized-cards{
    width: 100%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 5px;
}


/* ================= EACH CARD ================= */

.oversized-card{
    height: 310px;
    position: relative;
    overflow: hidden;
    border: 5px solid #f5c400;
    border-radius: 28px;
    background-color: black;
}


/* ================= IMAGE ================= */

.oversized-card img{
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}


/* ================= BLACK TEXT AREA ================= */

.card-title{
    position: absolute;
    left: 0;
    bottom: 0;

    width: 100%;
    height: 45px;

    background-color: black;
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 19px;
    letter-spacing: 2px;
    white-space: nowrap;
}


/* ================= JOGGER SECTION ================= */

.jogger2-section{
    width:100%;
    padding:20px;
    background:#fffdf5;
    overflow:hidden;
}

.jogger2-section h2{
    text-align:center;
    font-size:18px;
    font-weight:500;
    margin-bottom:30px;
}


/* HIDE RADIO */

.jogger2-section input{
    display:none;
}


/* SLIDER */

.jogger2-slider{
    width:100%;
    position:relative;
    overflow:hidden;
}


/* 3 PAGES */

.jogger2-pages{
    width:300%;
    display:flex;
    transition:transform 0.7s ease;
}


/* EACH PAGE */

.jogger2-page{
    width:33.333333%;
    flex-shrink:0;

    display:grid;
    grid-template-columns:repeat(5, 1fr);
    gap:12px;
}


/* CARD */

.jogger2-card{
    width:100%;
    min-width:0;
}


/* IMAGE */

.jogger2-img{
    width:100%;
    height:415px;
    position:relative;
    overflow:hidden;
    border-radius:8px;
}

.jogger2-img img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}


/* FIT */

.jogger2-img span{
    position:absolute;
    top:10px;
    left:8px;

    background:white;
    color:#555;

    padding:5px 8px;
    border-radius:4px;

    font-size:12px;
    font-weight:600;
}


/* DETAILS */

.jogger2-card p{
    margin-top:10px;
    line-height:1.5;
    font-size:16px;
}

.jogger2-card p b{
    font-size:16px;
    color:#303030;
}

.jogger2-card p small{
    color:#8794aa;
    font-size:15px;
}

.jogger2-card p strong{
    font-size:20px;
    color:#000;
}

.jogger2-card p del{
    color:#999;
    font-size:14px;
    margin-left:5px;
}

.jogger2-card p em{
    color:green;
    font-size:14px;
    font-style:normal;
    margin-left:5px;
}


/* ================= ARROWS ================= */

.jogger2-next,
.jogger2-prev{
    position:absolute;

    top:38%;

    width:52px;
    height:52px;

    background:white;
    border-radius:50%;

    align-items:center;
    justify-content:center;

    cursor:pointer;

    font-size:20px;

    box-shadow:0 2px 8px rgba(0,0,0,0.15);

    z-index:20;

    display:none;
}


/* RIGHT */

.jogger2-next{
    right:10px;
}


/* LEFT */

.jogger2-prev{
    left:10px;
}


/* ================= PAGE 1 ================= */

#jogger2-page1:checked ~ .jogger2-slider .jogger2-pages{
    transform:translateX(0);
}

#jogger2-page1:checked ~ .jogger2-slider .jogger2-next1{
    display:flex;
}


/* ================= PAGE 2 ================= */

#jogger2-page2:checked ~ .jogger2-slider .jogger2-pages{
    transform:translateX(-33.333333%);
}

#jogger2-page2:checked ~ .jogger2-slider .jogger2-next2{
    display:flex;
}

#jogger2-page2:checked ~ .jogger2-slider .jogger2-prev2{
    display:flex;
}


/* ================= PAGE 3 ================= */

#jogger2-page3:checked ~ .jogger2-slider .jogger2-pages{
    transform:translateX(-66.666666%);
}

#jogger2-page3:checked ~ .jogger2-slider .jogger2-prev3{
    display:flex;
}


/* ================= EXPLORE ALL ================= */

.jogger2-explore{
    width:100%;
    text-align:center;
    margin-top:30px;
}

.jogger2-explore a{
    color:#1599a8;
    font-size:16px;
    font-weight:600;
    text-decoration:underline;
}

/* ================= FOOTER ================= */

.footer{
    width:100%;
    background:#1d1d1d;
    color:white;
    padding:45px 25px 5px;
}


/* ================= LOGO ================= */

.footer-logo{
    width:100%;
    margin-bottom:25px;
}

.footer-logo img{
    width:240px;
    height:auto;
    filter:none;
}


/* ================= CONTENT ================= */

.footer-content{
    width:100%;
    display:grid;
    grid-template-columns:
        1.1fr
        1.1fr
        1.1fr
        1fr;

    column-gap:80px;
}


/* ================= COLUMN ================= */

.footer-column{
    display:flex;
    flex-direction:column;
}

.footer-column h3{
    color:#ffd21f;
    font-size:21px;
    margin-bottom:20px;
    font-weight:700;
}


/* ================= LINKS ================= */

.footer-column > a{
    color:white;
    text-decoration:none;
    font-size:16px;
    margin-bottom:12px;
}

.footer-column > a:hover{
    text-decoration:underline;
}


/* ================= RETURN / COD ================= */

.footer-info{
    margin-top:22px;
}

.footer-info a{
    display:flex;
    align-items:center;
    gap:20px;

    color:white;
    text-decoration:none;

    font-size:16px;
    margin-bottom:22px;
}

.footer-info i{
    width:20px;
    font-size:18px;
}


/* ================= DOWNLOAD APP ================= */

.download-title{
    margin-top:15px;
    margin-bottom:20px !important;
}

.app-links{
    display:flex;
    gap:12px;
}

.app-links img{
    width:130px;
    height:40px;
    object-fit:contain;
}

.app-links a{
    display:block;
}


/* ================= SOCIAL ================= */

.social-row{
    display:flex !important;
    flex-direction:row;
    align-items:center;

    gap:12px;

    color:white;
    text-decoration:none;

    margin-bottom:20px;
}

.social-row i{
    width:18px;
    font-size:20px;
}

.social-row span{
    font-size:16px;
}


/* ================= SOCIAL ICONS ================= */

.social-icons{
    display:flex;
    gap:20px;
    margin-top:2px;
    margin-bottom:38px;
}

.social-icons a{
    color:white;
    text-decoration:none;
    font-size:20px;
}

.social-icons a:hover{
    color:#ffd21f;
}


/* ================= PAYMENT ================= */

.payment-title{
    margin-bottom:20px !important;
}

.payment-icons{
    display:flex;
    align-items:center;
    gap:8px;
}

.payment-icons a{
    display:flex;
    align-items:center;
    justify-content:center;
}

.payment-icons img{
    width:48px;
    height:27px;
    object-fit:contain;
    background:white;
    border-radius:2px;
}


/* ================= SUBSCRIBE ================= */

.subscribe-column h3{
    margin-bottom:28px;
}

.subscribe-box{
    display:flex;
    width:100%;
    max-width:380px;
    height:42px;
}

.subscribe-box input{
    width:200px;
    height:42px;

    background:#000;
    color:white;

    border:none;
    border-bottom:1px solid #ffd21f;

    outline:none;

    padding:0 13px;

    font-size:18px;
}

.subscribe-box input::placeholder{
    color:#9aa8b8;
}

.subscribe-box button{
    width:180px;
    height:42px;

    border:none;

    background:#ffd21f;
    color:#222;

    font-size:16px;
    font-weight:bold;

    cursor:pointer;
}

.subscribe-box button:hover{
    background:#ffca00;
}


/* ================= BOTTOM LINE ================= */

.footer-line{
    width:100%;
    height:2px;

    background:#777;

    margin-top:30px;
}